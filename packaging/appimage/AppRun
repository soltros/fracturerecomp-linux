#!/bin/sh
set -eu
APPDIR=${APPDIR:-$(CDPATH= cd -- "${0%/*}" && pwd)}
export APPDIR
bb="$APPDIR/bootstrap/busybox"
if [ "$("$bb" uname -m)" != x86_64 ]; then
    echo 'Fracture Builder requires Linux x86_64.' >&2
    exit 1
fi
portable_data=${RECOMPLAUNCHER_DATA:-}
input_game=
host_scratch=
guest_scratch=/work/cache/tmp
waiting=
for argument in "$@"; do
    if [ "$waiting" = data ]; then portable_data=$argument; waiting=; continue; fi
    if [ "$waiting" = game ]; then input_game=$argument; waiting=; continue; fi
    case "$argument" in
        --data) waiting=data ;;
        --data=*) portable_data=${argument#--data=} ;;
        --game) waiting=game ;;
        --game=*) input_game=${argument#--game=} ;;
    esac
done
if [ -n "$waiting" ]; then echo "Missing value for --$waiting" >&2; exit 2; fi
data=${portable_data:-${FRACTURE_BUILDER_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/fracture-builder}}
"$bb" mkdir -p "$data"
data=$(CDPATH= cd -- "$data" && pwd)
if [ -n "$portable_data" ]; then
    # Portable launcher runs write only under the selected data directory.
    desktop_data=$data
    export FRACTURE_HOST_DATA= FRACTURE_HOST_DESKTOP_DATA= FRACTURE_DESKTOP_DATA=
    "$bb" mkdir -p "$data/cache/tmp" "$data/config" "$data/userdata"
    if [ -n "${TMPDIR:-}" ] && [ -d "$TMPDIR" ]; then
        host_scratch=$(CDPATH= cd -- "$TMPDIR" && pwd)
        guest_scratch=/launcher-tmp
    fi
else
    desktop_data=${XDG_DATA_HOME:-$HOME/.local/share}
    case "$desktop_data" in /*) ;; *) desktop_data="$HOME/.local/share" ;; esac
    "$bb" mkdir -p "$desktop_data"
    desktop_data=$(CDPATH= cd -- "$desktop_data" && pwd)
    export FRACTURE_HOST_DATA="$data"
    export FRACTURE_HOST_DESKTOP_DATA="$desktop_data"
    export FRACTURE_DESKTOP_DATA=/desktop-data
fi
export FRACTURE_HOST_LAUNCHER="$APPDIR/AppRun"
export FRACTURE_SOURCE_IMAGE= FRACTURE_INPUT_GAME=
# The virtual paths /opt and /work keep the prebuilt SDK, CMake imports and
# generated build files valid regardless of where the AppImage is stored.
# PRoot requires no container daemon or user namespaces. It is not a sandbox.
set -- "$@"
if [ "$#" -eq 0 ]; then
    set -- /usr/bin/python3 /opt/fracture-builder/launcher.py
else
    case "$1" in
        --self-test)
            set -- /bin/sh -ec 'clang++-20 --version; cmake --version; ninja --version; /opt/fracture-sdk/bin/rexglue --version; cmake -S /opt/fracture-builder/smoke -B /work/toolchain-smoke -G Ninja -DCMAKE_CXX_COMPILER=clang++-20 -DCMAKE_PREFIX_PATH=/opt/fracture-sdk; cmake --build /work/toolchain-smoke --parallel 2; /work/toolchain-smoke/sdk-smoke; /work/toolchain-smoke/portable-paths; python3 -c "import tkinter; import sys; sys.path.insert(0, \"/opt/fracture-builder\"); import builder; assert builder.default_jobs() >= 1; print(\"Offline toolchain ready\")"'
            ;;
        --build|--play|--prepare|--game|--game=*|--data|--data=*|--install-shortcut|--help)
            set -- /usr/bin/python3 /opt/fracture-builder/builder.py "$@"
            ;;
        *) echo 'Usage: FractureBuilder.AppImage [--build ISO_OR_FOLDER | --prepare --game ISO_OR_FOLDER | --play | --install-shortcut | --self-test] [--data DIRECTORY]' >&2; exit 2 ;;
    esac
fi
# Host graphics libraries are intentionally not placed in LD_LIBRARY_PATH:
# the included Mesa Vulkan drivers use the matching userspace in the image.
# Desktop sockets and /dev/dri remain available through these bindings.
unset LD_LIBRARY_PATH LD_PRELOAD PYTHONHOME PYTHONPATH TCL_LIBRARY TK_LIBRARY
unset VK_ICD_FILENAMES VK_DRIVER_FILES VK_LAYER_PATH
export PATH=/usr/bin:/bin
export PROOT_NO_SECCOMP=1
if [ -n "$portable_data" ]; then
    set -- /usr/bin/env RECOMPLAUNCHER_DATA=/work FRACTURE_DATA_MAPPED=1 XDG_DATA_HOME=/work/userdata \
        XDG_CONFIG_HOME=/work/config XDG_CACHE_HOME=/work/cache/xdg \
        TMPDIR="$guest_scratch" TEMP="$guest_scratch" TMP="$guest_scratch" "$@"
fi
set -- -w /work /usr/bin/env LD_LIBRARY_PATH=/opt/fracture-sdk/lib:/opt/fracture-sdk/lib64 "$@"
if [ -z "$portable_data" ] && [ -n "${APPIMAGE:-}" ] && [ -f "$APPIMAGE" ]; then
    export FRACTURE_SOURCE_IMAGE=/builder-image
    set -- -b "$APPIMAGE:/builder-image" "$@"
fi
if [ -n "$input_game" ]; then
    input_game=$("$bb" readlink -f "$input_game")
    if [ ! -e "$input_game" ]; then echo 'The selected game path does not exist.' >&2; exit 1; fi
    export FRACTURE_INPUT_GAME=/input-game
    set -- -b "$input_game:/input-game" "$@"
fi
if [ -n "$host_scratch" ]; then
    set -- -b "$host_scratch:/launcher-tmp" "$@"
fi
exec "$APPDIR/bootstrap/ld-linux-x86-64.so.2" \
    --library-path "$APPDIR/bootstrap/lib" "$APPDIR/bootstrap/proot" \
    -r "$APPDIR/rootfs" -b /dev -b /proc -b /sys -b /tmp -b /run \
    -b "$HOME" -b /media -b /mnt -b "$data:/work" \
    -b "$desktop_data:/desktop-data" "$@"
